rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return getUserData().role == 'admin';
    }
    
    function isPharmacy() {
      return getUserData().role == 'pharmacy';
    }
    
    function isVerifiedPharmacy() {
      return isPharmacy() && getUserData().isAdminApproved == true;
    }

    // --- Audit Logs Collection ---
    match /audit_logs/{logId} {
      allow read, create: if isSignedIn() && isAdmin();
    }

    // --- App Settings ---
    match /app_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      allow create: if request.auth != null && request.auth.uid == userId 
                    && request.resource.data.role == 'patient'
                    && (!('isAdminApproved' in request.resource.data.keys()) || request.resource.data.isAdminApproved == false);

      allow update: if request.auth != null && (
        // Path A: Regular users updating non-sensitive fields
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdminApproved', 'isVerified'])) ||
        // Path B: Admins can update 'isAdminApproved' for any user 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAdminApproved', 'approvedAt', 'isVerified', 'verificationStatus', 'approvedBy', 'role']))
      );
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true; // Public marketplace
      allow create: if isSignedIn() && isVerifiedPharmacy() 
                    && request.resource.data.pharmacyId == request.auth.uid;
      allow update, delete: if isSignedIn() && isVerifiedPharmacy() 
                            && resource.data.pharmacyId == request.auth.uid;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        resource.data.globalPharmacyId == request.auth.uid ||
        resource.data.pharmacyId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.patientId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.globalPharmacyId == request.auth.uid || 
        resource.data.pharmacyId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        resource.data.patientId == request.auth.uid
      );
    }
  }
}